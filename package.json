{
  "name": "@nodana/phoenixd-ts",
  "version": "0.1.2",
  "description": "A TypeScript client for Phoenixd Lightning nodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodana/phoenixd-ts.git"
  },
  "homepage": "https://github.com/nodana/phoenixd-ts#readme",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist && cp package.module.json dist/package.json && cp package.commonjs.json dist/cjs/package.json",
    "prepublishOnly": "npm test",
    "test": "run-s test:unit build",
    "test:unit": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/ws": "^8.5.10",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ]
}
