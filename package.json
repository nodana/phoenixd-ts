{
  "name": "@nodana/phoenixd-ts",
  "version": "0.2.0",
  "description": "A TypeScript client for Phoenixd Lightning nodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodana/phoenixd-ts.git"
  },
  "homepage": "https://github.com/nodana/phoenixd-ts#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run test:unit && npm run build && node tests/package-smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "esbuild": "^0.28.2"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
