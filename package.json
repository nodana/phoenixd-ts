  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.2",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "@types/ws": "^8.5.10",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "sinon": "^18.0.0",
    "sinon-chai": "^3.7.0",
    "typescript": "^5.4.5"
  },
  "files": [
    "dist"
  ]
